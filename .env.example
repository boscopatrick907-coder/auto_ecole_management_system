# ============================================================================
# AUTO-ÉCOLE LA MARSEILLAISE — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in the values (or let the agent populate them
# via npx neonctl and npx wrangler).
# ============================================================================

# 1. NEON SERVERLESS POSTGRESQL
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.neon.tech/la_marseillaise?sslmode=require"
DIRECT_DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/la_marseillaise?sslmode=require"

# 2. BETTER AUTH & OFFLINE LEASE SECURITY
BETTER_AUTH_SECRET="replace-with-64-char-hex-secret"
BETTER_AUTH_URL="http://localhost:8788"
JWT_OFFLINE_LEASE_SECRET="replace-with-64-char-hex-secret-for-clock-guard"

# 3. CLOUDFLARE R2 OBJECT STORAGE (Course PDFs & Videos - $0 Egress)
R2_ACCOUNT_ID="replace-with-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET_NAME="la-marseillaise-resources"
R2_SIGNED_URL_TTL_SECONDS="3600"

# 4. WHATSAPP BUSINESS CLOUD API & SMS FALLBACK
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="replace-with-meta-phone-number-id"
WHATSAPP_ACCESS_TOKEN="replace-with-meta-access-token"
WHATSAPP_VERIFY_TOKEN="replace-with-webhook-verify-token"
SCHOOL_OFFICIAL_WHATSAPP="+237600000000"
SMS_FALLBACK_PROVIDER="none"
SMS_API_KEY=""

# 5. N8N AUTOMATION WEBHOOKS
N8N_WEBHOOK_URL="http://localhost:5678/webhook/la-marseillaise"
N8N_WEBHOOK_SECRET="replace-with-hmac-webhook-secret"

# 6. INITIAL SUPER-ADMIN BOOTSTRAP
INITIAL_ADMIN_PHONE="+237600000000"
INITIAL_ADMIN_EMAIL="direction@lamarseillaise.cm"
INITIAL_ADMIN_NAME="Direction La Marseillaise"

# 7. PUBLIC FRONTEND VARIABLES (Angular PWA)
PUBLIC_API_BASE_URL="http://localhost:8788/api"
PUBLIC_APP_NAME="Auto-école La Marseillaise"
PUBLIC_DEFAULT_RECEIPT_PREFIX="LM"
PUBLIC_DEVICE_ID="D1"
