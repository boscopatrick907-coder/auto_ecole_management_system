{
  "name": "Auto-École La Marseillaise (AEM) — Automatisations WhatsApp & Relances Tranches",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aem-notifications",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Backend AEM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "daily-cron",
      "name": "Vérification Quotidienne 08h00 (Essais J+7, J+12, J+14 & Tranches)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{$env.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"recipient_type\": \"individual\",\n  \"to\": \"{{$json.body.phone}}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"{{$json.body.message}}\"\n  }\n}"
      },
      "id": "whatsapp-cloud-send",
      "name": "Envoi WhatsApp Cloud API (Meta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [620, 300]
    }
  ],
  "connections": {
    "Webhook Backend AEM": {
      "main": [
        [
          {
            "node": "Envoi WhatsApp Cloud API (Meta)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
