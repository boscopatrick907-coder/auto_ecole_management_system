{
  "name": "auto-ecole-la-marseillaise-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "test:neon": "tsx src/scripts/check-neon.ts",
    "test:phases": "vitest run tests/phases",
    "test:security": "vitest run tests/security",
    "test": "vitest run",
    "worker": "tsx src/scripts/worker.ts",
    "test:load": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
