# Copy to .dev.vars. Keep actual values out of version control.
DATABASE_URL="postgresql://restricted_app_login:REPLACE@HOST/neondb?sslmode=require"
AUTH_DATABASE_URL="postgresql://restricted_identity_login:REPLACE@HOST/neondb?sslmode=require"
BETTER_AUTH_SECRET="GENERATE_A_NEW_STRONG_RANDOM_VALUE"
BETTER_AUTH_URL="http://localhost:8788"
TRUSTED_ORIGINS="http://localhost:4200"
ENVIRONMENT="development"
TURNSTILE_SITE_KEY="YOUR_PUBLIC_SITE_KEY"
TURNSTILE_SECRET_KEY="YOUR_PRIVATE_SECRET"
OFFLINE_PRIVATE_KEY_PEM="YOUR_ED25519_PKCS8_PRIVATE_PEM"
R2_ACCOUNT_ID="YOUR_ACCOUNT"
R2_ACCESS_KEY_ID="YOUR_BUCKET_SCOPED_ACCESS_KEY"
R2_SECRET_ACCESS_KEY="YOUR_BUCKET_SCOPED_SECRET"
R2_BUCKET_NAME="YOUR_PRIVATE_CONTENT_BUCKET"
# Optional authenticated email relay for Better Auth password resets.
AUTH_EMAIL_WEBHOOK=""
AUTH_EMAIL_TOKEN=""
